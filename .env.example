# Токен бота от @BotFather
BOT_TOKEN=

# ID админов через запятую (свой узнать командой /id в боте)
ADMIN_IDS=

# ДЕМО-РЕЖИМ: true = бот работает целиком, но TON НЕ отправляются.
# Кошелёк и seed-фраза при DRY_RUN=true не нужны.
DRY_RUN=false

# Seed-фраза (24 слова) ГОРЯЧЕГО кошелька, с которого уходят выплаты.
# Держи на нём только оперативный остаток. НИКОГДА не коммить реальную фразу.
WALLET_MNEMONIC=word1 word2 ... word24

# Версия контракта кошелька. auto = бот определит сам по блокчейну:
# из одной seed-фразы каждая версия даёт свой адрес, активен только настоящий.
# Можно задать вручную: v3r2 | v4r2 | v5r1
WALLET_VERSION=auto

# Сеть: false = mainnet, true = testnet (для проверки)
TON_TESTNET=false

# Ключ Toncenter (опционально, поднимает лимиты): https://toncenter.com
TONCENTER_API_KEY=

# Премиум-эмодзи. Весь интерфейс построен на них, обычных эмодзи нет.
# Работают ТОЛЬКО если у аккаунта БОТА есть Telegram Premium.
USE_PREMIUM_EMOJI=true

# Название команды в шапке меню
TEAM_NAME=TONNFT team

# Фото-шапка меню: путь к файлу в репозитории, ссылка или file_id.
# Пусто = меню текстом. Локальный файл грузится один раз, дальше по file_id.
MENU_PHOTO=assets/team.png

# АВТО-ВЫПЛАТЫ: true = TON уходят сразу при начислении, работнику
# не нужно ничего нажимать. false = работник выводит кнопкой сам.
AUTO_PAYOUT=false

# Минимальная сумма вывода в TON
MIN_WITHDRAW_TON=0.1

# Комментарий к переводу (виден в блокчейне)
PAYOUT_COMMENT=payout

# Путь к файлу БД
DB_PATH=payouts.db

# ═══ ПОДАРКИ: приём NFT и авто-продажа на MRKT ═══
# false = бот работает только как выплатной, подарки не трогает.
GIFTS_ENABLED=false

# Ключи с my.telegram.org — нужны и вотчеру подарков, и MRKT.
TG_API_ID=
TG_API_HASH=

# Строковая сессия ТВОЕГО аккаунта: python scripts/gen_session.py
# Даёт полный доступ к аккаунту — только в переменных окружения, не в коде.
TG_SESSION=

# Доля воркера от суммы продажи, в процентах
WORKER_SHARE_PERCENT=80

# На сколько процентов ставить ниже флора, чтобы уходило быстрее
UNDERCUT_PERCENT=3

# Разрешить выставлять по флору КОЛЛЕКЦИИ, когда нет флора по модели+фону.
# По умолчанию false: флор коллекции занижает редкие атрибуты (чёрный фон
# и т.п.), и подарок уйдёт сильно дешевле реальной цены.
ALLOW_COLLECTION_FLOOR=false

# Ниже этой цены подарки не выставляем
MIN_LIST_PRICE_TON=0.5

# Аккаунт, на который передаются подарки для продажи.
# Подарок не попадает на маркет сам — его нужно передать сюда.
MRKT_DEPOSIT_ACCOUNT=mrktbank

# Заявка воркера на свободный подарок требует подтверждения админом.
# Слаг подарка публичный (виден в ссылке), поэтому без подтверждения
# чужой подарок со скрытым отправителем мог бы забрать любой желающий.
CLAIM_NEEDS_APPROVAL=true

# Период опроса MRKT в секундах
GIFTS_POLL_SEC=120

# Файл сессии MRKT в base64. На сервере нет консоли, а amrkt без сессии
# спрашивает телефон и падает с EOFError. Получить строку:
#   python scripts/gen_mrkt_session.py
MRKT_SESSION_B64=

# Куда класть файл сессии. Пусто = рядом с базой (на volume),
# чтобы авторизация переживала редеплой.
MRKT_WORKDIR=
